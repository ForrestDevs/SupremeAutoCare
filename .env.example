# Postgres connection string used by Payload (Vercel Postgres, Neon, Supabase, ...)
DATABASE_URI=postgresql://postgres@127.0.0.1:5432/supremeautocare

# Used to sign Payload's auth cookies. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Optional. When set, uploaded media is stored in Vercel Blob instead of the
# local ./media folder. Required in production — Vercel's filesystem is read-only.
# BLOB_READ_WRITE_TOKEN=
